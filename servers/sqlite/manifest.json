    "active_tools": [
      "read_query",
      "write_query",
      "create_table",
      "list_tables",
      "describe_table"
    ],
    "unsupported_tools": []
  },
  "security": {
    "ast_audit_passed": true,
    "prompt_injection_scanned": true,
