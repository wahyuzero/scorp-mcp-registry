  "tools": [
    {
      "name": "read_query",
      "description": "Execute a SELECT query and return results as a markdown table"
    },
    {
      "name": "write_query",
      "description": "Execute an INSERT, UPDATE, or DELETE statement"
    },
    {
      "name": "create_table",
      "description": "Create a new table (CREATE TABLE statements only)"
    },
    {
      "name": "list_tables",
      "description": "List all user tables in the database"
    },
    {
      "name": "describe_table",
      "description": "Show column schema for a table"
    }
  ],
